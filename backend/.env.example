NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/reachinbox_db
REDIS_URL=redis://localhost:6379
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
SESSION_SECRET=change_this_to_a_random_32_char_string
FRONTEND_URL=http://localhost:3000

# ─── SMTP Configuration ────────────────────────────────────────────────────────
# These values are used as defaults when creating new senders.
# Choose ONE of the options below and fill in your credentials.
#
# Option A — Gmail (enable "App Passwords" in your Google account first)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_16_char_app_password
#
# Option B — SendGrid (free tier: 100 emails/day)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.your_sendgrid_api_key_here
#
# Option C — Resend (free tier: 3 000 emails/month — RECOMMENDED for Render Free tier over HTTPS port 443)
# RESEND_API_KEY=re_your_resend_api_key_here
# RESEND_FROM_EMAIL=onboarding@resend.dev
#
# Option D — Brevo / Mailjet / Postmark — same pattern, check their SMTP docs.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password_or_api_key
# Set RESEND_API_KEY to send emails via HTTPS (Port 443) bypassing cloud SMTP blocks:
# RESEND_API_KEY=re_...
# ───────────────────────────────────────────────────────────────────────────────

WORKER_CONCURRENCY=5
LIMITER_DURATION_MS=2000
MAX_JOBS_PER_DURATION=2
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=100
BASE_RETRY_DELAY_MS=30000
MAX_RETRY_DELAY_MS=1800000
JITTER_MS=10000
MAX_RETRY_ATTEMPTS=5
